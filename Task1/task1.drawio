        <mxCell id="rbH4icJtX2ochDFMoCQp-1818" value="Партнёр из одной управляющей компании может увидеть данные клиентов и жилищных комплексов, которые относятся к другой компании." style="whiteSpace=wrap;html=1;fontSize=14;fillColor=#64bbe2;strokeColor=none;fontColor=#FFFFFF;rounded=1;shadow=0;labelBackgroundColor=none;strokeWidth=3;spacing=5;arcSize=7;" vertex="1" parent="1">
