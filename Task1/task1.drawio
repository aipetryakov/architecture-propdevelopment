        </mxCell>
        <mxCell id="rbH4icJtX2ochDFMoCQp-1820" value="Есть несколько точек регистрации нового клиента, координации между этими точками нет." style="whiteSpace=wrap;html=1;fontSize=14;fillColor=#64bbe2;strokeColor=none;fontColor=#FFFFFF;rounded=1;shadow=0;labelBackgroundColor=none;strokeWidth=3;spacing=5;arcSize=7;" vertex="1" parent="1">
