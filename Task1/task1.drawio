        <mxCell id="rbH4icJtX2ochDFMoCQp-1825" value="В личном кабинете иногда могут отображаться данные другого клиента — например, другое Ф. И. О." style="whiteSpace=wrap;html=1;fontSize=14;fillColor=#64bbe2;strokeColor=none;fontColor=#FFFFFF;rounded=1;shadow=0;labelBackgroundColor=none;strokeWidth=3;spacing=5;arcSize=7;" vertex="1" parent="1">
